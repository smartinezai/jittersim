# The Pi-only cutover lab: the kernel-test image plus mature DHCP, DNS, capture and
# mDNS tools (dnsmasq, ISC dhclient, tcpdump, scapy, avahi-daemon, curl).
# Build from the repository root:
#   docker build -f tests/kernel/Dockerfile.outage-lab -t jittersim-lab-outage .
#   docker run --rm --privileged jittersim-lab-outage
FROM python:3.11-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 nftables iputils-ping unbound \
       dnsutils hostapd conntrack dnsmasq-base isc-dhcp-client tcpdump curl avahi-daemon \
       procps ethtool \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir scapy==2.6.1
WORKDIR /jittersim
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .
COPY tests ./tests
COPY deploy ./deploy
ENV JITTERSIM_KERNEL_TESTS=1 JITTERSIM_OUTAGE_LAB=1
CMD ["python", "-m", "unittest", "-v", "tests.kernel.test_outage_lab"]
