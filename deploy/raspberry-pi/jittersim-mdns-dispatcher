#!/bin/sh
set -eu

device=${1:-}
action=${2:-}
[ -n "$device" ] && [ -n "$action" ] || exit 0
[ -r /etc/jittersim/runtime.env ] || exit 0
. /etc/jittersim/runtime.env
[ "$device" = "${JITTERSIM_UPLINK:-eth0}" ] || exit 0

case "$action" in
    pre-down|down)
        systemctl stop jittersim-mdns.service
        ;;
    up|dhcp4-change|reapply)
        systemctl restart jittersim-mdns.service
        ;;
esac
