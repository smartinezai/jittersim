#!/bin/sh
set -eu

# NetworkManager calls this with the interface and the event. When the Ethernet
# address or the test Wi-Fi changes, the name publisher checks both networks at
# once instead of waiting for its next regular check. It never restarts, so a
# DHCP renewal that keeps the address does not briefly withdraw the name.
device=${1:-}
action=${2:-}
[ -n "$device" ] && [ -n "$action" ] || exit 0
[ -r /etc/jittersim/runtime.env ] || exit 0
. /etc/jittersim/runtime.env
case "$device" in
    "${JITTERSIM_UPLINK:-eth0}"|"${JITTERSIM_TEST_INTERFACE:-wlan0}") ;;
    *) exit 0 ;;
esac

case "$action" in
    up|down|dhcp4-change|reapply)
        systemctl kill --kill-whom=main --signal=HUP jittersim-mdns.service 2>/dev/null || true
        ;;
esac
