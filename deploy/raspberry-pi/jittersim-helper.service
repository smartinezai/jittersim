[Unit]
Description=JitterSim privileged networking helper
# Boot restoration finishes first, so it cannot restore household rules after a
# Panic the helper serves, and the helper's own startup decision is applied last.
After=network-online.target jittersim-access-boot.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=jittersim
RuntimeDirectory=jittersim
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
EnvironmentFile=/etc/jittersim/runtime.env
ExecStart=/opt/jittersim/.venv/bin/jittersim-helper --socket /run/jittersim/helper.sock --uplink ${JITTERSIM_UPLINK} --test-interface ${JITTERSIM_TEST_INTERFACE} --enable-hardware
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
