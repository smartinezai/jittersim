[Unit]
Description=JitterSim filtered DNS
After=local-fs.target

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -o jittersim -g jittersim -m0700 /run/jittersim/dns-observations
ExecStart=/opt/jittersim/.venv/bin/python -m jittersim.networking.dns_decisions --config /var/lib/jittersim-access/unbound.conf --socket /run/jittersim/dns-observations/events.sock --pid-file /run/jittersim/dns-producer.json
Restart=on-failure
RestartSec=2
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/jittersim
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
