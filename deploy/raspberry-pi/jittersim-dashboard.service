[Unit]
Description=JitterSim dashboard
Requires=jittersim-helper.service jittersim-control-firewall.service
After=jittersim-helper.service jittersim-control-firewall.service

[Service]
Type=simple
User=jittersim
Group=jittersim
WorkingDirectory=/var/lib/jittersim
EnvironmentFile=/etc/jittersim/control.env
ExecStart=/opt/jittersim/.venv/bin/jittersim-dashboard --database /var/lib/jittersim/jittersim.db --host 0.0.0.0 --port 8080 --helper-socket /run/jittersim/helper.sock
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jittersim /run/jittersim

[Install]
WantedBy=multi-user.target
